{
  "name": "domain-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "域名雷达 · 全球 1,436 个根域后缀的域名可用性批量扫描（Cloudflare Workers + 静态前端）",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:whois": "node scripts/build-whois-map.mjs",
    "dev": "node src/dev-server.mjs",
    "check": "node --test test/core.test.mjs",
    "e2e": "node test/e2e.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
